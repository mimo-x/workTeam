# Business API
NODE_ENV=development
HOST=0.0.0.0
PORT=8790
DATABASE_URL=postgres://agent_team:agent_team@127.0.0.1:54329/agent_team
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=replace-with-at-least-32-random-characters
# Development only. Generate with: openssl rand -base64 32
KEY_PROVIDER=local
ENCRYPTION_MASTER_KEY=
# Production uses Vault Transit for the wrapping key.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=agent-team
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8790

# OpenIM Platform API. Keep the administrator token on this backend only.
OPENIM_API_URL=http://127.0.0.1:10002
OPENIM_WS_URL=ws://127.0.0.1:10001
OPENIM_ADMIN_TOKEN=replace-with-openim-admin-token
# Configure this value on the internal OpenIM before/after message webhook URL.
OPENIM_CALLBACK_TOKEN=replace-with-a-random-callback-token
OPENIM_PLATFORM_ID=4

HOST_LEASE_SECONDS=30
HOST_HEARTBEAT_SECONDS=10
