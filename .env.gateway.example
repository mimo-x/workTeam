# Agent Gateway 只应运行在可信服务端，管理员 Token 不得放进 Electron。
AGENT_GATEWAY_PORT=8787
AGENT_GATEWAY_SECRET=replace-with-a-long-random-value
OPENIM_API_ADDR=http://127.0.0.1:10002
OPENIM_ADMIN_TOKEN=replace-with-openim-admin-token
AGENT_IDS=agent_coordinator,agent_architect,agent_coder,agent_reviewer
# 生产环境建议限制允许发布到的群；留空表示不限制。
OPENIM_GROUP_IDS=group_001
