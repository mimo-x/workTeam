{
  "name": "codex-desktop-chat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "gateway:dev": "node --env-file=.env.gateway.local gateway/server.mjs",
    "backend:dev": "npm run dev --workspace @agent-team/chat-api",
    "backend:worker": "npm run worker --workspace @agent-team/chat-api",
    "backend:build": "npm run build --workspace @agent-team/chat-api",
    "backend:test": "npm run test --workspace @agent-team/chat-api",
    "backend:migrate": "npm run db:migrate --workspace @agent-team/chat-api",
    "validate:bugs": "node scripts/validate-bug-governance.mjs",
    "test:agent-team": "esbuild tests/agent-team-direct.test.ts --bundle --platform=node --format=esm --outfile=/tmp/codex-desktop-agent-team-test.mjs && node --test /tmp/codex-desktop-agent-team-test.mjs",
    "test:desktop": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.desktop.json",
    "web:dev": "next dev --turbopack",
    "web:build": "next build",
    "web:start": "next start",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@openim/electron-client-sdk": "^3.8.3-patch.15.1",
    "@openim/wasm-client-sdk": "^3.8.3-patch.15.1"
  },
  "devDependencies": {
    "@ai-sdk/deepseek": "latest",
    "@assistant-ui/ai-sdk": "latest",
    "@assistant-ui/next": "latest",
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-markdown": "latest",
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^7.0.85",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.local.codexdesktop",
    "productName": "Codex Desktop",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openim/electron-client-sdk/assets/**/*",
      "node_modules/koffi/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "target": "AppImage"
    }
  }
}
